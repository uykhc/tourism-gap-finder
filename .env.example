# Copy this file to .env and fill in the keys for the APIs you use.
#
# 공공데이터포털(data.go.kr)은 계정당 서비스 키 하나를 승인된 모든 API에 쓴다.
# 아래 세 이름을 따로 채우는 대신 TOUR_API_SERVICE_KEY 한 줄만 채워도 되며,
# 세 조회 함수 모두 그 값으로 폴백한다. 실측으로 KorService2(관광자원),
# DataLabService(방문자), AreaTarResDemService·AreaTarDemDsService(수요지수)가
# 하나의 키로 모두 응답하는 것을 확인했다.
TOUR_API_SERVICE_KEY=

# 위 공용 키 대신 API별로 나눠 쓰려면 아래를 채운다 (공용 키보다 우선한다).
KOR_TOUR_API_SERVICE_KEY=
HUB_TOUR_API_SERVICE_KEY=
# 이동통신 기반 지역별 방문자 수(DataLabService), 지역별 관광 자원 수요,
# 지역별 관광 수요 강도.
VISITOR_API_SERVICE_KEY=

# KAKAO_REST_API_KEY는 호환용 직접 수집기에만 필요합니다.
KAKAO_REST_API_KEY=

# 심화 release 생성 시 읽을 콘텐츠 DB와 변경하지 않는 completed run UUID.
CONTENT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
KAKAO_COLLECTION_RUN_ID=

# SGIS OpenAPI3: 인구·면적·사업체. 구조 특성 17개 변수에 필요합니다.
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=

# 사전 생성 AI 보고서용. 운영 HTTP 요청에서는 사용하지 않습니다.
OPENAI_API_KEY=

# 중심 관광지·성과 산출물의 공통 기준월(YYYYMM).
ANALYSIS_BASE_YEAR_MONTH=202608
REQUIRED_ADVANCED_REPORT_COUNT=0

AUTH_DATABASE_URL=sqlite:///./apps/api/tourism_gap_finder.db
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_MINUTES=60
# 로그인 시 remember_me를 쓸 때의 만료(분). 기본 43200 = 30일.
AUTH_REMEMBER_ME_MINUTES=43200
AUTH_RATE_LIMIT_PER_MINUTE=10
API_ENV=development

# 프론트엔드 오리진. 쉼표로 구분합니다.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 분석 산출물 루트. 로컬 기본값은 data/artifacts이며 운영에서는 영구 볼륨을 지정합니다.
# ANALYSIS_ARTIFACT_ROOT=data/artifacts
