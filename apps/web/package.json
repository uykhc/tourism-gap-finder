{
  "name": "tourism-gap-finder-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@4.9.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "VITE_API_MOCKING=true vite",
    "dev:api": "VITE_API_MOCKING=false vite",
    "build": "tsc -b && vite build",
    "lint": "biome lint .",
    "fix": "biome check --write .",
    "check:types": "tsc -b",
    "check:format": "biome check .",
    "check:unused": "knip",
    "check-all": "yarn check:types && yarn check:format && yarn check:unused"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "pretendard": "^1.3.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.87.0",
    "react-router": "^7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@tailwindcss/vite": "^4",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "knip": "^5.59.1",
    "msw": "^2.15.0",
    "tailwindcss": "^4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "msw": {
    "workerDirectory": ["public"]
  }
}
